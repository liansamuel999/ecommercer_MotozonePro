run = "cd server && npm install && npm run build && npm run seed && npm start"
modules = ["nodejs-20"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && npm install && npm run build && npm run seed && npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
